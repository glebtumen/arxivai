TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Optional: only needed if Telegram's API is blocked/throttled on your
# network (common in some countries). Leave empty otherwise.
# Examples:
#   TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
#   TELEGRAM_PROXY_URL=http://user:pass@host:port
# If you use a socks5:// proxy, also run: pip install aiohttp-socks
TELEGRAM_PROXY_URL=
TELEGRAM_REQUEST_TIMEOUT=60
